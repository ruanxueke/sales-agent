# ============================================
# 销售客服智能体 - 环境变量配置
# 复制此文件为 .env 并填写配置
# ============================================

# --- 密钥管理 ---
# 商用建议设置 SECRET_KEY，并把 API Key 用 deploy/encrypt_secret.py 加密后填 enc: 前缀值
SECRET_KEY=请设置一个随机长字符串

# --- 数据库 ---
# 留空则用项目内 data/customers.db（SQLite，仅适合单机开发）
# DATABASE_URL=postgresql://sales:你的密码@postgres:5432/sales
# 是否允许 init_db() 用 create_all 直接建表。create_all 只建「缺失的表」，
# 永远不会修改已存在的表——所以给已有表加字段时线上不会生效。
# 正式部署必须为 false，并让发布流程执行 deploy/migrate.sh（docker compose 的
# migrate 服务已内置）；本地开发保留 true 可零配置起步。
# AUTO_CREATE_TABLES=false

# --- Redis（商用启用，不填则内存模式） ---
# REDIS_URL=redis://:你的密码@r-bp1xxxx.redis.rds.aliyuncs.com:6379/0
# 语义缓存专用 Redis（强烈建议独立于上面的状态库：
# 状态库存放锁/去重键/限流计数，绝不能开 LRU 淘汰；缓存需要 allkeys-lru）
# CACHE_REDIS_URL=redis://:你的密码@r-bp1xxxx.redis.rds.aliyuncs.com:6379/1
# docker compose 部署时 redis 的密码，务必改掉默认值：
# REDIS_PASSWORD=请设置一个随机长字符串
# docker compose 部署时 postgres 的密码，务必改掉默认值：
# PG_PASSWORD=请设置一个随机长字符串

# --- 容器运行身份（非 root） ---
# 容器以非 root 运行（Dockerfile 里 USER app）。data/ 与 vector_store/ 是 bind
# mount，宿主机这两个目录的属主必须和这里一致，否则容器会 Permission denied。
# deploy.sh 的 [1/9] 会用这组值自动 chown，改成别的值时无需手工干预。
# APP_UID=1000
# APP_GID=1000

# --- 对象存储（备份归档） ---
# OBJECT_STORAGE_PROVIDER=s3
# OBJECT_STORAGE_BUCKET=your-bucket
# OBJECT_STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OBJECT_STORAGE_REGION=oss-cn-hangzhou
# OBJECT_STORAGE_ACCESS_KEY=your-access-key-id
# OBJECT_STORAGE_SECRET_KEY=your-access-key-secret

# --- DeepSeek V4 Flash ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- 备用模型（主模型余额不足或故障时自动切换）---
# 未单独填写 BACKUP_LLM_API_KEY 时，复用上面的 DASHSCOPE_API_KEY。
BACKUP_LLM_PROVIDER=dashscope
BACKUP_LLM_MODEL=qwen-plus
BACKUP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BACKUP_LLM_API_KEY=sk-your-backup-key

# --- 嵌入模型 ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-你的百炼APIKey

# --- 向量数据库 ---
CHROMA_COLLECTION_NAME=sales_knowledge

# --- RAG 配置 ---
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
# auto: PostgreSQL 已安装 pgvector 时使用数据库向量，否则回退租户 JSON 索引
RAG_BACKEND=auto

# --- 支付与合规 ---
# 正式环境必须配置支付回调密钥；未配置时拒绝未验签回调
PAYMENT_WEBHOOK_SECRET=请设置一个随机长字符串
ALLOW_UNSIGNED_PAYMENT_WEBHOOK=false
CHAT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=180
DELETION_SLA_DAYS=15
DATA_CLASSIFICATION_ENABLED=true

# --- 个人微信 ---
WECHAT_TYPE=personal
WECHAT_PERSONAL_HOT_RELOAD=true
WECHAT_PERSONAL_QR_PATH=qr.png

# --- 公众号 ---
# WECHAT_OFFICIAL_APP_ID=wx-your-app-id
# WECHAT_OFFICIAL_APP_SECRET=your-app-secret
# WECHAT_OFFICIAL_TOKEN=your-token
# WECHAT_OFFICIAL_ENCODING_AES_KEY=your-aes-key
# WECHAT_OFFICIAL_SERVER_HOST=0.0.0.0
# WECHAT_OFFICIAL_SERVER_PORT=8080
# WECHAT_OFFICIAL_REPLY_MODE=async

# --- 企业微信客户联系（需先开通客户联系） ---
# WECOM_CORP_ID=ww-企业ID
# WECOM_CONTACT_SECRET=客户联系Secret
# WECOM_AGENT_ID=自建应用AgentId
# WECOM_TOKEN=你填的Token
# WECOM_ENCODING_AES_KEY=你生成的AESKey
# 明文模式回调开关：企业微信明文模式不带签名，任何人都能伪造"客户消息"直达 Agent，
# 因此默认拒绝。确需明文模式时才置为 true（强烈建议改配 AES 密钥走安全模式）。
# WECOM_ALLOW_PLAINTEXT_CALLBACK=false
# WECOM_KF_SECRET=微信客服Secret（启用微信客服模式时填写）
# WECOM_KF_OPEN_KFID=微信客服账号ID（启用微信客服模式时填写）
# 回调地址：http://127.0.0.1:5000/wecom（需公网可访问）

# --- 日志 ---
LOG_LEVEL=INFO

# --- Wechaty 配置 ---
AI_API_URL=http://127.0.0.1:5002/api/v1/chat

# --- 语音识别（Vosk 模型路径，需为纯英文路径） ---
# VOSK_MODEL_PATH=C:\path\to\vosk-model-small-cn-0.22

# --- 销售线索通知 ---
# SALES_NOTIFY_TARGET=叙白
# BOT_NOTIFY_PORT=3900

# --- 销售线索中台 ---
# 默认线索归属人（当前固定为叙白）
LEAD_DEFAULT_OWNER=叙白
# 超时未跟进自动退回公海的天数
LEAD_RECYCLE_AFTER_DAYS=3
# 单次批量导入最大条数
LEAD_IMPORT_MAX_ROWS=5000
# 公众号关注/扫码时的自动欢迎语
WECHAT_OFFICIAL_WELCOME=您好，欢迎关注！我是这里的课程顾问，可以叫我小助手。您是想先了解一下，还是对 AI 学习有具体想聊的方向？

# --- 接口安全（逗号分隔多个 Key；留空为本地开发模式） ---
# API_KEYS=sk-admin-1,sk-viewer-1
# ADMIN_API_KEYS=sk-admin-1
# 本地微信桥接默认从 API_KEYS 读取第一个 Key，也可单独设置：
# PERSONAL_WECHAT_API_KEY=sk-admin-1
# MESSAGE_DEDUP_TTL_HOURS=24

# --- 定时任务与自动跟进 ---
# ENABLE_SCHEDULER=true
# SCHEDULER_INTERVAL_SECONDS=60
# FOLLOWUP_ENABLED=true
# FOLLOWUP_NODES_HOURS=1,24,72,168
# HANDOVER_ENABLED=true

# --- 回复节奏 ---
# 最快回复延迟（秒），避免秒回；AI 生成超过该值则按实际时间
# MIN_REPLY_DELAY_SECONDS=5

# --- 视觉受管执行器（仿识流，企业授权后开启） ---
# 默认关闭，需要管理员在服务器 .env 显式开启
# VISION_AGENT_ENABLED=false
# VISION_AGENT_MODE=wecom   # wecom 企业微信 / wechat 个人微信
# VISION_AGENT_MAX_SENDS_PER_DAY=300
# VISION_AGENT_POLL_INTERVAL=3
# VISION_MODEL=qwen-vl-max
# VISION_HANDOVER_KEYWORDS=人工,投诉,退款,转人工,转客服,客服处理,投诉处理,真人,电话联系
# VISION_AGENT_MONITOR=企业微信   # 桌面端窗口标题匹配
